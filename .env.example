DATABASE_URL=sqlite:///./widgets.db
JWT_SECRET=change-me-to-a-long-random-string
PUBLIC_BASE_URL=http://localhost:8000
# Only set true behind a trusted proxy that sets X-Forwarded-For
TRUST_PROXY=false
# How many reverse proxies sit in front of the app. The client is the Nth entry from the RIGHT of X-Forwarded-For.
TRUSTED_PROXY_HOPS=1
RATE_LIMIT_IP_MAX=5
RATE_LIMIT_IP_WINDOW_SECONDS=10
RATE_LIMIT_WIDGET_MAX=30
RATE_LIMIT_WIDGET_WINDOW_SECONDS=10

# Geo providers (leave GEO_MOCK_* empty outside tests)
GEO_TIMEOUT_SECONDS=2
GEO_A_URL=https://ipapi.co/{ip}/json/
GEO_B_URL=http://ip-api.com/json/{ip}
GEO_MOCK_A=
GEO_MOCK_B=
# Webhook side effect (leave NOTIFY_WEBHOOK_URL empty to disable)
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_SECRET=
NOTIFY_TIMEOUT_SECONDS=3
NOTIFY_MOCK=
